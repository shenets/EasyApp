{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Clusters": {
      "weatherForecast": {
        "Destinations": {
          "weatherForecastService": { "Address": "https://localhost:7299" }
        }
      }
    },
    "Routes": [
      {
        "RouteId": "weatherForecastRoute",
        "ClusterId": "weatherForecast",
        "Match": { "Path": "/weatherForecast/{**catch-all}" }
      }
    ]
  }

}

